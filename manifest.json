{
  "manifest_version": 3,
  "name": "Formly",
  "version": "1.0",

  "description": "AI powered Google Form autofill assistant",

  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://docs.google.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*"
      ],
      "js": ["gemini.js","content.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["profile.json", "images/*", "assets/*"],
      "matches": ["https://docs.google.com/*"]
    }
  ]
}